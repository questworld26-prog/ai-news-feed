<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.aibriefing.daily</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/prithis/.local/bin/uv</string>
        <string>run</string>
        <string>src/generate_news_digest.py</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/prithis/QuestWorld/AI_news_voice_feed</string>

    <!-- Run every day at 12:00 PM (Noon) local time -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>12</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <key>StandardOutPath</key>
    <string>/Users/prithis/Library/Logs/com.aibriefing.daily.out.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/prithis/Library/Logs/com.aibriefing.daily.err.log</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin:/Users/prithis/.local/bin</string>
    </dict>
</dict>
</plist>
